# syntax=docker/dockerfile:1.7
# Railway sandbox pilot image: runtime app + Prisma CLI for preDeploy migrate,
# plus entrypoint that materializes *_FILE secrets from injected source vars.

FROM node:22.23.2-bookworm-slim AS build
WORKDIR /app
ENV NODE_ENV=development
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src
RUN DATABASE_URL=postgresql://mino:build-only@127.0.0.1:5432/mino \
    npm run prisma:generate \
 && npm run build

FROM node:22.23.2-bookworm-slim AS railway
WORKDIR /app
ENV NODE_ENV=production \
    MINO_HOST=0.0.0.0 \
    MINO_PORT=3000
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 mino \
 && useradd --system --uid 10001 --gid mino --home-dir /app --shell /usr/sbin/nologin mino

# Keep Prisma CLI (devDependency) available for preDeployCommand migrate.
COPY --from=build --chown=mino:mino /app/package.json /app/package-lock.json ./
COPY --from=build --chown=mino:mino /app/node_modules ./node_modules
COPY --from=build --chown=mino:mino /app/dist ./dist
COPY --from=build --chown=mino:mino /app/prisma.config.ts ./prisma.config.ts
COPY --from=build --chown=mino:mino /app/prisma ./prisma
COPY --chown=mino:mino scripts/railway-entrypoint.sh /app/railway-entrypoint.sh

USER 10001:10001
EXPOSE 3000
ENTRYPOINT ["/app/railway-entrypoint.sh"]
CMD ["npm", "start"]
