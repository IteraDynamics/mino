generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MandateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApprovalMode {
  AUTO_APPROVE
  DUAL_SIGNATURE_SLACK
  HARD_BLOCK
}

enum DecisionVerdict {
  ALLOW
  BLOCK
  PENDING_HUMAN_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalVoteDecision {
  APPROVE
  REJECT
}

enum SpendReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum PaymentOutcomeStatus {
  FORWARDING
  UNKNOWN
  SUCCEEDED
  FAILED_DEFINITIVE
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  agents          AgentIdentity[]
  policies        Policy[]
  mandates        AgentMandate[]
  auditLogs       AuditLog[]
  approvals       ApprovalRequest[]
  reservations    SpendReservation[]
  merchants       MerchantEndpoint[]
  paymentOutcomes PaymentOutcome[]
}

model MerchantEndpoint {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  externalMerchantId String
  domain             String
  vendorId           String?
  baseUrl            String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, externalMerchantId])
  @@index([organizationId, domain, active])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  email          String
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id])
  mandates        AgentMandate[]
  auditLogs       AuditLog[]
  approvals       ApprovalRequest[]
  reservations    SpendReservation[]
  paymentOutcomes PaymentOutcome[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model AgentIdentity {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  externalAgentId String
  displayName     String?
  status          AgentStatus @default(ACTIVE)
  publicKey       String?
  keyId           String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id])
  mandates        AgentMandate[]
  auditLogs       AuditLog[]
  approvals       ApprovalRequest[]
  reservations    SpendReservation[]
  paymentOutcomes PaymentOutcome[]

  @@unique([organizationId, externalAgentId])
  @@index([organizationId, status])
}

model Policy {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  version        Int
  active         Boolean @default(true)

  baseCurrency           String @default("USD") @db.Char(3)
  maxBudgetMinor         BigInt @db.BigInt
  rollingDailyLimitMinor BigInt @db.BigInt

  approvedMerchantDomains String[]
  approvedVendorIds       String[]
  restrictedCategories    String[]
  approvalMode            ApprovalMode

  maxTransactionsPerMinute Int @default(10)
  crossMerchantWindowSecs  Int @default(60)
  maxDistinctMerchants     Int @default(5)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  mandates     AgentMandate[]

  @@unique([organizationId, name, version])
  @@index([organizationId, active])
}

model AgentMandate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  agentId        String @db.Uuid
  policyId       String @db.Uuid

  tokenJtiHash  String @unique
  policyVersion Int

  currency               String @default("USD") @db.Char(3)
  maxBudgetMinor         BigInt @db.BigInt
  rollingDailyLimitMinor BigInt @db.BigInt

  approvedMerchantDomains String[]
  approvedVendorIds       String[]
  restrictedCategories    String[]
  approvalMode            ApprovalMode

  maxTransactionsPerMinute Int @default(10)
  crossMerchantWindowSecs  Int @default(60)
  maxDistinctMerchants     Int @default(5)

  delegationPayloadHash String
  signingKeyId          String

  status    MandateStatus @default(ACTIVE)
  issuedAt  DateTime      @default(now()) @db.Timestamptz(6)
  expiresAt DateTime      @db.Timestamptz(6)
  revokedAt DateTime?     @db.Timestamptz(6)
  metadata  Json?

  organization    Organization  @relation(fields: [organizationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  agent           AgentIdentity @relation(fields: [agentId], references: [id])
  policy          Policy        @relation(fields: [policyId], references: [id])
  auditLogs       AuditLog[]
  approvals       ApprovalRequest[]
  reservations    SpendReservation[]
  paymentOutcomes PaymentOutcome[]

  @@index([organizationId, agentId, status, expiresAt])
  @@index([userId, status])
}

model SpendReservation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  agentId        String @db.Uuid
  mandateId      String @db.Uuid

  idempotencyKey   String
  merchantDomain   String
  merchantVendorId String?
  currency         String @db.Char(3)
  amountMinor      BigInt @db.BigInt
  status           SpendReservationStatus @default(RESERVED)

  reservedAt  DateTime  @default(now()) @db.Timestamptz(6)
  committedAt DateTime? @db.Timestamptz(6)
  releasedAt  DateTime? @db.Timestamptz(6)
  expiresAt   DateTime  @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  agent        AgentIdentity @relation(fields: [agentId], references: [id])
  mandate      AgentMandate  @relation(fields: [mandateId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([mandateId, status, reservedAt])
  @@index([userId, reservedAt])
}

model PaymentOutcome {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  agentId        String @db.Uuid
  mandateId      String @db.Uuid

  reservationId     String @unique
  idempotencyKey    String
  requestDigest     String
  merchantId        String
  merchantDomain    String
  checkoutSessionId String
  amountMinor       BigInt @db.BigInt
  currency          String @db.Char(3)
  status            PaymentOutcomeStatus @default(FORWARDING)

  upstreamStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  lastErrorCode   String?

  forwardedAt                  DateTime? @db.Timestamptz(6)
  resolvedAt                   DateTime? @db.Timestamptz(6)
  lastReconciledAt             DateTime? @db.Timestamptz(6)
  reconcileAttempts            Int       @default(0)
  nextReconcileAt              DateTime? @db.Timestamptz(6)
  reconciliationLeaseOwner     String?
  reconciliationLeaseExpiresAt DateTime? @db.Timestamptz(6)
  createdAt                    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  agent        AgentIdentity @relation(fields: [agentId], references: [id])
  mandate      AgentMandate  @relation(fields: [mandateId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, updatedAt])
  @@index([mandateId, status, updatedAt])
  @@index([checkoutSessionId, status])
  @@index([status, nextReconcileAt, reconciliationLeaseExpiresAt])
}

model ApprovalRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  agentId        String @db.Uuid
  mandateId      String @db.Uuid

  decisionId     String @unique
  requestId      String
  idempotencyKey String
  requestDigest  String
  policyVersion  Int

  merchantId        String
  merchantDomain    String
  checkoutSessionId String?

  requestedPayload Json
  sessionSnapshot  Json?
  spendSnapshot    Json?
  reasonCodes      String[]
  amountMinor      BigInt @db.BigInt
  currency         String @db.Char(3)

  status             ApprovalStatus @default(PENDING)
  requiredSignatures Int            @default(2)
  approvalData       Json?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  agent        AgentIdentity  @relation(fields: [agentId], references: [id])
  mandate      AgentMandate   @relation(fields: [mandateId], references: [id])
  votes        ApprovalVote[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([mandateId, status])
  @@index([expiresAt, status])
}

model ApprovalVote {
  id                String               @id @default(uuid()) @db.Uuid
  approvalRequestId String               @db.Uuid
  approverId        String
  decision          ApprovalVoteDecision
  comment           String?
  metadata          Json?
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId, approverId])
  @@index([approvalRequestId, decision, createdAt])
}

model AuditLog {
  id             BigInt @id @default(autoincrement())
  organizationId String @db.Uuid
  requestId      String @db.Uuid
  decisionId     String @db.Uuid
  userId         String @db.Uuid
  agentId        String @db.Uuid
  mandateId      String? @db.Uuid
  timestamp      DateTime @default(now()) @db.Timestamptz(6)

  protocol                  String
  operation                 String
  merchantDomain            String
  merchantVendorId          String?
  requestedPayload          Json
  approvedPayload           Json?
  verdict                   DecisionVerdict
  reasonCodes               String[]
  policyVersion             Int?
  evaluationLatencyMicros   Int

  requestDigest       String
  eventDigest         String
  integritySignature String
  signingKeyId        String
  metadata            Json?

  organization Organization  @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  agent        AgentIdentity @relation(fields: [agentId], references: [id])
  mandate      AgentMandate? @relation(fields: [mandateId], references: [id])

  @@index([organizationId, timestamp])
  @@index([agentId, timestamp])
  @@index([userId, timestamp])
  @@index([merchantDomain, timestamp])
  @@index([decisionId])
  @@index([requestId])
}
